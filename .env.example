# QuantumPilot AI - Environment Variables (Placeholders Only)
# DO NOT commit real tokens. Replace with your own.

# IBM Quantum
IBM_TOKEN=YOUR_IBM_CLOUD_API_KEY_HERE
IBM_CRN=YOUR_IBM_CRN_HERE
IBM_CHANNEL=ibm_cloud

# HuggingFace (optional for Granite inference)
HF_TOKEN=YOUR_HF_TOKEN_HERE

# Database (for Docker)
POSTGRES_USER=quantumpilot
POSTGRES_PASSWORD=quantumpilot_secure_change_me
POSTGRES_DB=quantumpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Security
SECRET_KEY=prod-secret-change-me-32chars-minimum

# API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://quantumpilot-ai.vercel.app"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
